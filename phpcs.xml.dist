<?xml version="1.0"?>
<ruleset name="Factory">
    <description>PSR-12 for production code, tests, executable examples and documentation tools.</description>
    <rule ref="PSR12"/>
    <!-- Self-contained examples and synthetic fixtures intentionally group their types. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests/Fixtures.php</exclude-pattern>
        <exclude-pattern>*/examples/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>*/examples/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>*/examples/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>tools</file>
    <arg name="colors"/>
</ruleset>
