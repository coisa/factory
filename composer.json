{
    "name": "coisa/factory",
    "type": "library",
    "description": "Explicit, replaceable construction strategies for modern PHP and legacy-to-DI migration",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentor.dev.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "league/commonmark": "^2.8",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpspec/prophecy": "^1.22",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "phpspec/prophecy": "Required only for the optional ProphecyFactory and ProphesizeFactory testing adapters (^1.22)."
    },
    "autoload": {
        "psr-4": {
            "CoiSA\\Factory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoiSA\\Factory\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "check": [
            "@validate-package",
            "@lint",
            "@sniff",
            "@analyse",
            "@test",
            "@examples",
            "@docs"
        ],
        "validate-package": "@composer validate --strict",
        "lint": "parallel-lint --exclude vendor --exclude build --exclude tmp .",
        "sniff": "phpcs",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "examples": "@php tools/check-examples.php",
        "docs": [
            "@php tools/build-docs.php",
            "@php tools/check-docs.php"
        ]
    }
}
